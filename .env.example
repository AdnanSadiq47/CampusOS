# ==============================================================================
# CampusOS Environment Configuration Baseline (.env.example)
# NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql://campus_app_user:campus_secure_password@localhost:5432/campus_os_db
DATABASE_MIGRATION_URL=postgresql://postgres:postgres_admin_password@localhost:5432/campus_os_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis Configuration (Cache, Sessions, Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Authentication Security (Generate 64+ char random hex keys in production)
JWT_ACCESS_SECRET=replace_with_a_super_secure_random_64_character_access_secret_key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_super_secure_random_64_character_refresh_secret_key
JWT_REFRESH_EXPIRATION=7d

# Password Security (Argon2 work factors)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=debug
