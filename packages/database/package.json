{
  "name": "@campus-os/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "require": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema/index.ts src/seed/cli.ts src/safety/lock-cli.ts src/recovery/recovery-cli.ts --format cjs,esm --dts --external @electric-sql/pglite",
    "dev": "tsup src/index.ts src/schema/index.ts src/seed/cli.ts src/safety/lock-cli.ts src/recovery/recovery-cli.ts --format cjs,esm --dts --external @electric-sql/pglite --watch",
    "db:seed": "node dist/seed/cli.js",
    "db:identity:init": "node dist/safety/lock-cli.js identity:init",
    "db:recovery:export": "node dist/recovery/recovery-cli.js export",
    "db:recovery:create-staging": "node dist/recovery/recovery-cli.js create-staging",
    "db:recovery:restore-staging": "node dist/recovery/recovery-cli.js restore-staging",
    "db:recovery:verify-staging": "node dist/recovery/recovery-cli.js verify-staging",
    "verify:locks": "node dist/safety/lock-cli.js verify",
    "lock:page": "node dist/safety/lock-cli.js lock",
    "unlock:page": "node dist/safety/lock-cli.js unlock",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:security": "vitest run test/real-postgres-rls.spec.ts test/tenant-isolation.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@campus-os/logger": "workspace:*",
    "@campus-os/types": "workspace:*",
    "@electric-sql/pglite": "^0.5.5",
    "drizzle-orm": "^0.31.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.22.7",
    "tsup": "^8.1.0",
    "typescript": "5.5.2",
    "vitest": "^1.6.0"
  }
}
