{
  "name": "campus-os",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Configurable Multi-Organization ERP Platform",
  "author": "CampusOS Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:security": "turbo run test:security",
    "typecheck": "turbo run typecheck",
    "db:seed": "pnpm --filter @campus-os/database db:seed",
    "verify:locks": "pnpm --filter @campus-os/database verify:locks",
    "lock:page": "pnpm --filter @campus-os/database lock:page",
    "unlock:page": "pnpm --filter @campus-os/database unlock:page",
    "web:dev:check": "pnpm --filter @campus-os/web dev:check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.2",
    "turbo": "^2.0.4",
    "typescript": "5.5.2"
  },
  "packageManager": "pnpm@9.15.0"
}
